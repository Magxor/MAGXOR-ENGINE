# Magxor Engine — variables de entorno
# Copiar a .env.local y completar.

# URL del Web App de Apps Script (/exec). ÚNICO endpoint de la tienda.
VITE_APPS_SCRIPT_URL=""

# Token público de lectura (Script Properties > READ_TOKEN). Solo permite getConfig/getProducts/getReviews.
VITE_READ_TOKEN=""

# ImgBB para subir imágenes de productos/logo (https://api.imgbb.com). Sin fallback en código.
VITE_IMGBB_API_KEY=""
